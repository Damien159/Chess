@using Chess.Models

<div class="flex min-h-10 flex-wrap items-center gap-0.5 rounded-lg bg-board-light px-2 py-1">
    <span class="mr-2 text-xs font-semibold text-slate-600">@Label</span>

    @foreach (var piece in Pieces)
    {
        <span class="select-none text-2xl leading-none @ColorClass(piece)">@piece.Symbol</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<Piece> Pieces { get; set; } = default!;

    private static string ColorClass(Piece piece) => piece.Color == PieceColor.White
        ? "text-white [text-shadow:0_0_3px_#000]"
        : "text-slate-900";
}
