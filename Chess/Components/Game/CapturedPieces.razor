@using Chess.Models

<div class="flex min-h-12 items-center gap-3 rounded-xl border border-slate-800 bg-slate-900/60 px-4 py-2">
    <span class="shrink-0 text-xs font-medium uppercase tracking-wider text-slate-500">@Label</span>
    <span class="flex flex-wrap items-center text-2xl leading-none">
        @foreach (var piece in Pieces)
        {
            <span class="@(piece.Color == PieceColor.White ? "text-white" : "text-slate-500")">@piece.Symbol</span>
        }
    </span>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public IEnumerable<Piece> Pieces { get; set; } = [];
}
