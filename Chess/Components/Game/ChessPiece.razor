@using Chess.Models

<span class="select-none text-4xl leading-none sm:text-5xl @ColorClass">@Piece.Symbol</span>

@code {
    [Parameter, EditorRequired]
    public Piece Piece { get; set; } = default!;

    private string ColorClass => Piece.Color == PieceColor.White
        ? "text-white [text-shadow:0_0_3px_#000]"
        : "text-slate-900";
}
