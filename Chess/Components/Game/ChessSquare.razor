@using Chess.Models

@* Ein Feld des Bretts: reine Darstellung. Farbe und Markierungen kommen über Parameter, *@
@* ein Klick wird nur nach oben gemeldet (OnClick). Die Entscheidung trifft ChessBoard. *@
<div @onclick="() => OnClick.InvokeAsync()"
     class="chess-square relative flex aspect-square cursor-pointer items-center justify-center @(IsCheck ? "bg-red-500" : IsLastMove ? (IsLight ? "bg-board-light-last" : "bg-board-dark-last") : IsLight ? "bg-board-light" : "bg-board-dark") @(IsSelected ? "ring-4 ring-inset ring-yellow-400" : "") @(IsTarget && Piece is not null ? "ring-4 ring-inset ring-red-500/70" : "")">

    @if (Piece is not null)
    {
        <ChessPiece Piece="Piece" />
    }

    @if (IsTarget && Piece is null)
    {
        <span class="pointer-events-none absolute h-4 w-4 rounded-full bg-black/25"></span>
    }

    @if (RankLabel is not null)
    {
        <span class="absolute left-0.5 top-0 text-[11px] sm:text-xs font-semibold @LabelColor">@RankLabel</span>
    }

    @if (FileLabel is not null)
    {
        <span class="absolute bottom-0 right-0.5 text-[11px] sm:text-xs font-semibold @LabelColor">@FileLabel</span>
    }
</div>

@code {
    [Parameter] public Piece? Piece { get; set; }
    [Parameter] public bool IsLight { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsTarget { get; set; }
    [Parameter] public bool IsCheck { get; set; }
    [Parameter] public bool IsLastMove { get; set; }
    [Parameter] public string? RankLabel { get; set; }
    [Parameter] public string? FileLabel { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    // Die Beschriftung hat jeweils die andere Brettfarbe, damit sie lesbar bleibt.
    private string LabelColor => IsLight ? "text-board-dark" : "text-board-light";
}


