@using Chess.Models

<div class="relative w-full max-w-[560px]">
    <div class="grid w-full grid-cols-8 overflow-hidden rounded-xl shadow-2xl">
        @for (var row = 0; row < 8; row++)
        {
            for (var col = 0; col < 8; col++)
            {
                var r = Flipped ? 7 - row : row;
                var f = Flipped ? 7 - col : col;
                <ChessSquare Piece="Game.Board[r, f]"
                             IsLight="(r + f) % 2 == 0"
                             IsSelected="IsSelected(r, f)"
                             IsTarget="IsTarget(r, f)"
                             IsCheck="IsKingInCheck(r, f)"
                             RankLabel="@(col == 0 ? (8 - r).ToString() : null)"
                             FileLabel="@(row == 7 ? ((char)('a' + f)).ToString() : null)"
                             OnClick="() => SelectSquare(r, f)" />
            }
        }
    </div>

    @if (_pendingPromotion is not null)
    {
        <div class="absolute inset-0 z-10 flex items-center justify-center rounded-xl bg-black/60">
            <div class="rounded-2xl bg-slate-800 p-4 shadow-2xl">
                <p class="mb-3 text-center text-sm text-slate-300">Bauer umwandeln in:</p>
                <div class="flex gap-2">
                    @foreach (var type in PromotionTypes)
                    {
                        <button @onclick="() => PromoteAsync(type)"
                                class="flex h-16 w-16 items-center justify-center rounded-xl bg-board-light hover:bg-yellow-200">
                            <ChessPiece Piece="new Piece(type, Game.CurrentTurn)" />
                        </button>
                    }
                </div>
                <button @onclick="CancelPromotion"
                        class="mt-3 w-full rounded-lg bg-slate-700 px-3 py-1 text-sm hover:bg-slate-600">
                    Abbrechen
                </button>
            </div>
        </div>
    }
</div>

@code {
    private static readonly PieceType[] PromotionTypes =
        [PieceType.Queen, PieceType.Rook, PieceType.Bishop, PieceType.Knight];

    private Square? _selected;
    private IReadOnlyList<Square> _targets = Array.Empty<Square>();
    private (Square From, Square To)? _pendingPromotion;

    [Parameter, EditorRequired]
    public Game Game { get; set; } = default!;

    [Parameter]
    public bool Flipped { get; set; }

    [Parameter]
    public EventCallback OnMoved { get; set; }

    private bool IsSelected(int rank, int file) =>
        _selected is { } s && s.Rank == rank && s.File == file;

    private bool IsTarget(int rank, int file) =>
        _targets.Contains(new Square(rank, file));

    private bool IsKingInCheck(int rank, int file) =>
        Game.Status is GameStatus.Check or GameStatus.Checkmate
        && Game.Board[rank, file] is { Type: PieceType.King } king
        && king.Color == Game.CurrentTurn;

    private async Task SelectSquare(int rank, int file)
    {
        if (_pendingPromotion is not null)
        {
            return;
        }

        var clicked = new Square(rank, file);

        if (_selected is { } from && _targets.Contains(clicked))
        {
            if (Game.IsPromotion(from, clicked))
            {
                _pendingPromotion = (from, clicked);
                return;
            }

            Game.TryMove(from, clicked);
            Deselect();
            await OnMoved.InvokeAsync();
            return;
        }

        if (_selected == clicked || !Game.IsOwnPiece(clicked))
        {
            Deselect();
            return;
        }

        _selected = clicked;
        _targets = Game.GetMoves(clicked);
    }

    private async Task PromoteAsync(PieceType type)
    {
        if (_pendingPromotion is not { } pending)
        {
            return;
        }

        _pendingPromotion = null;
        Game.TryMove(pending.From, pending.To, type);
        Deselect();
        await OnMoved.InvokeAsync();
    }

    private void CancelPromotion()
    {
        _pendingPromotion = null;
        Deselect();
    }

    private void Deselect()
    {
        _selected = null;
        _targets = Array.Empty<Square>();
    }
}
