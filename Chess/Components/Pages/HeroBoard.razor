@implements IDisposable

<figure class="relative mx-auto w-full max-w-xl">
    <div class="relative bg-slate-800 p-8 shadow-2xl shadow-black/60 ring-1 ring-slate-700">
        <div class="relative aspect-square w-full"
             style="container-type:inline-size;background:conic-gradient(#a47551 25%,#ecd9b5 0 50%,#a47551 0 75%,#ecd9b5 0) 0 0/25% 25%;">

            @if (_fromC >= 0)
            {
                <div class="absolute bg-emerald-400/45" style="@Pos(_fromC, _fromR)width:12.5%;height:12.5%;"></div>
                <div class="absolute bg-emerald-400/45" style="@Pos(_toC, _toR)width:12.5%;height:12.5%;"></div>
            }

            @foreach (var p in _pieces)
            {
                <div class="absolute flex items-center justify-center transition-all duration-700 ease-in-out @(p.Dead ? "scale-50 opacity-0" : "") @(p.Id == _movingId ? "z-10" : "")"
                     style="@Pos(p.C, p.R)width:12.5%;height:12.5%;font-size:10cqw;line-height:1;">
                    <span class="select-none @(char.IsUpper(p.Ch) ? "text-[#fbf3e2]" : "text-[#1b1511]")"
                          style="@(char.IsUpper(p.Ch) ? "text-shadow:0 0 1px #1b1511,0 1px 2px rgba(0,0,0,.6);" : "text-shadow:0 0 1px #f0e0c0,0 1px 2px rgba(0,0,0,.4);")">@Glyph(p.Ch)</span>
                </div>
            }
        </div>

        <div class="absolute inset-x-8 bottom-1.5 flex text-[11px] text-slate-500">
            @foreach (var f in "abcdefgh")
            {
                <span class="flex-1 text-center">@f</span>
            }
        </div>
        <div class="absolute inset-y-8 left-1.5 flex w-5 flex-col text-[11px] text-slate-500">
            @for (var r = 8; r >= 1; r--)
            {
                <span class="flex flex-1 items-center justify-center">@r</span>
            }
        </div>
    </div>

    <figcaption class="mt-5 min-h-[4.5rem]">
        <p class="font-display text-2xl text-white">@_note&nbsp;</p>
        <p class="mt-1 text-sm text-slate-400">@_caption</p>
    </figcaption>
</figure>

@code {
    private const string Start = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR";

    // Anderssen - Kieseritzky, London 1851 (von-nach:Notation)
    private static readonly string[] Moves =
    {
        "e2e4:e4", "e7e5:e5", "f2f4:f4", "e5f4:exf4", "f1c4:Lc4", "d8h4:Dh4+",
        "e1f1:Kf1", "b7b5:b5", "c4b5:Lxb5", "g8f6:Sf6", "g1f3:Sf3", "h4h6:Dh6",
        "d2d3:d3", "f6h5:Sh5", "f3h4:Sh4", "h6g5:Dg5", "h4f5:Sf5", "c7c6:c6",
        "g2g4:g4", "h5f6:Sf6", "h1g1:Tg1", "c6b5:cxb5", "h2h4:h4", "g5g6:Dg6",
        "h4h5:h5", "g6g5:Dg5", "d1f3:Df3", "f6g8:Sg8", "c1f4:Lxf4", "g5f6:Df6",
        "b1c3:Sc3", "f8c5:Lc5", "c3d5:Sd5", "f6b2:Dxb2", "f4d6:Ld6", "c5g1:Lxg1",
        "e4e5:e5", "b2a1:Dxa1+", "f1e2:Ke2", "b8a6:Sa6", "f5g7:Sxg7+", "e8d8:Kd8",
        "f3f6:Df6+", "g8f6:Sxf6", "d6e7:Le7#"
    };

    private static readonly Dictionary<int, string> Captions = new()
    {
        [3] = "Königsgambit: Weiß bietet einen Bauern an.",
        [7] = "Weiß verliert das Rochaderecht und macht trotzdem weiter.",
        [21] = "Der Turm geht nach g1. Material ist dem Angriff egal.",
        [34] = "Schwarz nimmt, was er kriegen kann.",
        [36] = "Der zweite Turm ist weg.",
        [38] = "Weiß hat keinen Turm mehr.",
        [43] = "Jetzt opfert Weiß auch die Dame.",
        [45] = "Matt. Mit zwei Springern und einem Läufer."
    };

    private sealed class HeroPiece { public int Id; public char Ch; public int C; public int R; public bool Dead; }

    private List<HeroPiece> _pieces = new();
    private int _fromC = -1, _fromR, _toC, _toR, _movingId = -1;
    private string _note = "";
    private string _caption = "";
    private readonly CancellationTokenSource _cts = new();

    protected override void OnInitialized() => Reset();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ = RunAsync(_cts.Token);
    }

    private void Reset()
    {
        _pieces = new List<HeroPiece>();
        var id = 0;
        var rows = Start.Split('/');
        for (var r = 0; r < 8; r++)
        {
            var c = 0;
            foreach (var ch in rows[r])
            {
                if (char.IsDigit(ch)) c += ch - '0';
                else _pieces.Add(new HeroPiece { Id = id++, Ch = ch, C = c++, R = r });
            }
        }
        _fromC = -1;
        _movingId = -1;
        _note = "";
        _caption = "Grundstellung. Gleich wird es wild.";
    }

    private async Task RunAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(2200, ct);
                for (var i = 0; i < Moves.Length; i++)
                {
                    Apply(i);
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(i == Moves.Length - 1 ? 7000 : 1100, ct);
                }
                Reset();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void Apply(int i)
    {
        var parts = Moves[i].Split(':');
        var from = parts[0][..2];
        var to = parts[0][2..];
        (_fromC, _fromR) = Sq(from);
        (_toC, _toR) = Sq(to);

        var target = _pieces.FirstOrDefault(p => !p.Dead && p.C == _toC && p.R == _toR);
        if (target is not null) target.Dead = true;

        var mover = _pieces.First(p => !p.Dead && p.C == _fromC && p.R == _fromR);
        mover.C = _toC;
        mover.R = _toR;
        _movingId = mover.Id;

        var n = i / 2 + 1;
        _note = i % 2 == 0 ? $"{n}. {parts[1]}" : $"{n}\u2026 {parts[1]}";
        if (Captions.TryGetValue(i + 1, out var text)) _caption = text;
    }

    private static (int C, int R) Sq(string s) => (s[0] - 'a', 8 - (s[1] - '0'));

    private static string Pos(int c, int r) => $"left:calc({c} * 12.5%);top:calc({r} * 12.5%);";

    private static string Glyph(char p) => char.ToLower(p) switch
    {
        'k' => "\u265A",
        'q' => "\u265B",
        'r' => "\u265C",
        'b' => "\u265D",
        'n' => "\u265E",
        _ => "\u265F\uFE0E"
    };

    public void Dispose() => _cts.Cancel();
}
