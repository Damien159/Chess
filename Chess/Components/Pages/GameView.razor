@page "/games/{Id:int}"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Chess.Components.Game
@using Chess.Data
@using Chess.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject GameRepository Repository

<PageTitle>Partie ansehen</PageTitle>

@if (_stored is null || _view is null || _full is null)
{
    <div class="mx-auto max-w-xl text-center">
        <p class="text-slate-400">Diese Partie wurde nicht gefunden.</p>
        <a href="games" class="mt-3 inline-block text-emerald-400 hover:underline">Zurück zu meinen Partien</a>
    </div>
}
else
{
    <div class="flex flex-col items-center gap-6">
        <h1 class="text-2xl font-bold">Partie vom @_stored.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</h1>

        <p class="text-slate-300">
            Ergebnis: <span class="font-mono font-semibold text-white">@(_stored.Result ?? "unvollendet")</span>
            <span class="text-slate-500">&middot; @CurrentMoveText</span>
        </p>

        <div class="flex w-full flex-col items-center gap-6 lg:flex-row lg:items-start lg:justify-center">
            @* pointer-events-none: Das Brett dient hier nur zum Ansehen, Klicks darauf haben keine Wirkung. *@
            <div class="pointer-events-none w-full max-w-[560px] shrink-0 lg:w-[560px]">
                <ChessBoard Game="_view" Flipped="_flipped" />
            </div>

            <aside class="flex w-full max-w-[560px] flex-col gap-4 lg:w-80">
                <MoveList Moves="_full.Moves" Result="@_stored.Result" />

                <div class="flex flex-wrap gap-2">
                    <button @onclick="() => GoTo(0)" disabled="@(_ply == 0)"
                            class="rounded-xl bg-slate-800 px-4 py-2 text-sm hover:bg-slate-700 disabled:opacity-40">
                        Anfang
                    </button>
                    <button @onclick="() => GoTo(_ply - 1)" disabled="@(_ply == 0)"
                            class="rounded-xl bg-slate-800 px-4 py-2 text-sm hover:bg-slate-700 disabled:opacity-40">
                        Zurück
                    </button>
                    <button @onclick="() => GoTo(_ply + 1)" disabled="@(_ply == _total)"
                            class="rounded-xl bg-slate-800 px-4 py-2 text-sm hover:bg-slate-700 disabled:opacity-40">
                        Vor
                    </button>
                    <button @onclick="() => GoTo(_total)" disabled="@(_ply == _total)"
                            class="rounded-xl bg-slate-800 px-4 py-2 text-sm hover:bg-slate-700 disabled:opacity-40">
                        Ende
                    </button>
                </div>

                <div class="flex flex-wrap gap-2">
                    <button @onclick="() => _flipped = !_flipped"
                            class="rounded-xl bg-slate-800 px-4 py-2 text-sm hover:bg-slate-700">
                        Brett drehen
                    </button>
                    <a href="games" class="rounded-xl bg-slate-800 px-4 py-2 text-sm hover:bg-slate-700">
                        Meine Partien
                    </a>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private StoredGame? _stored;
    private Game? _full;
    private Game? _view;
    private int _ply;
    private int _total;
    private bool _flipped;

    // GetGameAsync filtert nach der Benutzer-Id. Fremde Partien lassen sich auch über die Adresse nicht abrufen.
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (userId is null)
        {
            return;
        }

        _stored = await Repository.GetGameAsync(Id, userId);

        if (_stored is null)
        {
            return;
        }

        _total = _stored.Moves.Count;
        _full = Replay(_total);
        _view = _full;
        _ply = _total;
    }

    // Es wird nicht rückwärts gerechnet. Stattdessen wird die Partie bis zum gewünschten Halbzug neu nachgespielt.
    private void GoTo(int ply)
    {
        _ply = Math.Clamp(ply, 0, _total);
        _view = _ply == _total ? _full : Replay(_ply);
    }

    // Spielt die ersten n Halbzüge auf einem neuen Spiel nach
    private Game Replay(int ply) => _stored!.ToGame(ply);

    private string CurrentMoveText
    {
        get
        {
            if (_ply == 0)
            {
                return "Grundstellung";
            }

            var move = _full!.Moves[_ply - 1];
            var number = (_ply + 1) / 2;
            var dots = _ply % 2 == 1 ? "." : "...";
            return $"Zug {_ply} von {_total}: {number}{dots} {move.Notation}";
        }
    }
}
