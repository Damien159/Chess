@page "/"

<PageTitle>ChessPlatform</PageTitle>

<section class="relative mx-auto grid max-w-6xl items-center gap-14 overflow-hidden py-10 lg:grid-cols-[1fr_1.05fr] lg:py-16">
    <span aria-hidden="true" class="pointer-events-none absolute -left-20 -top-24 select-none font-display text-[28rem] leading-none text-slate-900">&#9822;&#xFE0E;</span>

    <div class="relative">
        <h1 class="mb-0 text-7xl leading-[0.95] sm:text-8xl">
            Eine<br /><em class="text-emerald-400">Runde?</em>
        </h1>

        <p class="mt-8 max-w-sm text-lg leading-relaxed text-slate-400">
            Brett aufstellen, ziehen, fertig. Gegen den Computer oder gegen den neben dir.
            Jede Partie landet danach im Archiv.
        </p>

        <nav class="mt-12 max-w-md border-t border-slate-700">
            <a href="play" class="group flex items-baseline gap-5 border-b border-slate-700 py-4 transition hover:bg-slate-900/70">
                <span class="w-8 font-display text-lg italic text-slate-500">1.</span>
                <span class="font-display text-3xl text-white">Neue Partie</span>
                <span class="ml-auto text-xl text-emerald-400 transition group-hover:translate-x-1.5">&rarr;</span>
            </a>
            <AuthorizeView>
                <Authorized>
                    <a href="games" class="group flex items-baseline gap-5 border-b border-slate-700 py-4 transition hover:bg-slate-900/70">
                        <span class="w-8 font-display text-lg italic text-slate-500">2.</span>
                        <span class="font-display text-3xl text-white">Meine Partien</span>
                        <span class="ml-auto text-xl text-emerald-400 transition group-hover:translate-x-1.5">&rarr;</span>
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Register" class="group flex items-baseline gap-5 border-b border-slate-700 py-4 transition hover:bg-slate-900/70">
                        <span class="w-8 font-display text-lg italic text-slate-500">2.</span>
                        <span class="font-display text-3xl text-white">Konto anlegen</span>
                        <span class="ml-auto text-xl text-emerald-400 transition group-hover:translate-x-1.5">&rarr;</span>
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>

        <p class="mt-6 max-w-md text-sm text-slate-500">
            Rochade, en passant, Umwandlung und alle Remisregeln sind drin. Gespeichert wird nach jedem Zug.
        </p>
    </div>

    <div class="relative">
        <HeroBoard @rendermode="InteractiveServer" />
        <p class="mt-2 text-xs uppercase tracking-[0.2em] text-slate-600">Anderssen &ndash; Kieseritzky, London 1851</p>
    </div>
</section>
