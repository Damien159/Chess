@page "/"

<PageTitle>ChessPlatform</PageTitle>

<section class="mx-auto w-full max-w-[44rem] py-8">
    <p class="mb-4 text-2xl font-bold tracking-tight text-white">Zieh eine Figur.</p>

    <div class="grid grid-cols-8 shadow-2xl shadow-black/60 ring-8 ring-slate-800">
        @for (var r = 0; r < 8; r++)
        {
            @for (var c = 0; c < 8; c++)
            {
                var p = _b[r, c];
                var name = $"{(char)('a' + c)}{8 - r}";
                var bg = (r + c) % 2 == 1 ? "bg-board-dark" : "bg-board-light";
                var tone = char.IsUpper(p) ? "text-white" : "text-slate-950";
                var shadow = char.IsUpper(p) ? "text-shadow:0 1px 2px rgb(0 0 0 / .55);" : "";

                @if (name == "e2")
                {
                    <a href="play" title="Neue Partie" class="chess-square group relative flex aspect-square items-center justify-center ring-2 ring-inset ring-emerald-400 @bg">
                        <span class="chess-piece select-none @tone" style="@shadow">@Glyph(p)</span>
                        <span class="pointer-events-none absolute -top-9 left-1/2 z-10 -translate-x-1/2 whitespace-nowrap rounded bg-white px-2 py-1 text-xs font-semibold text-slate-950 opacity-0 group-hover:opacity-100">Neue Partie</span>
                    </a>
                }
                else if (name == "g1")
                {
                    <AuthorizeView>
                        <Authorized>
                            <a href="games" title="Meine Partien" class="chess-square group relative flex aspect-square items-center justify-center ring-2 ring-inset ring-emerald-400 @bg">
                                <span class="chess-piece select-none @tone" style="@shadow">@Glyph(p)</span>
                                <span class="pointer-events-none absolute -top-9 left-1/2 z-10 -translate-x-1/2 whitespace-nowrap rounded bg-white px-2 py-1 text-xs font-semibold text-slate-950 opacity-0 group-hover:opacity-100">Meine Partien</span>
                            </a>
                        </Authorized>
                        <NotAuthorized>
                            <a href="Account/Register" title="Konto anlegen" class="chess-square group relative flex aspect-square items-center justify-center ring-2 ring-inset ring-emerald-400 @bg">
                                <span class="chess-piece select-none @tone" style="@shadow">@Glyph(p)</span>
                                <span class="pointer-events-none absolute -top-9 left-1/2 z-10 -translate-x-1/2 whitespace-nowrap rounded bg-white px-2 py-1 text-xs font-semibold text-slate-950 opacity-0 group-hover:opacity-100">Konto anlegen</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                }
                else
                {
                    <div class="chess-square flex aspect-square items-center justify-center @bg">
                        @if (p != '\0')
                        {
                            <span class="chess-piece select-none @tone" style="@shadow">@Glyph(p)</span>
                        }
                    </div>
                }
            }
        }
    </div>

    <p class="mt-5 text-sm text-slate-400">
        <span class="text-white">Bauer e2</span> startet eine Partie.
        <AuthorizeView>
            <Authorized><span class="text-white">Springer g1</span> öffnet deine Partien.</Authorized>
            <NotAuthorized><span class="text-white">Springer g1</span> legt ein Konto an.</NotAuthorized>
        </AuthorizeView>
    </p>
</section>

@code {
    private readonly char[,] _b = Parse("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR");

    private static char[,] Parse(string fen)
    {
        var b = new char[8, 8];
        var rows = fen.Split('/');
        for (var r = 0; r < 8; r++)
        {
            var c = 0;
            foreach (var ch in rows[r])
            {
                if (char.IsDigit(ch)) c += ch - '0';
                else b[r, c++] = ch;
            }
        }
        return b;
    }

    private static string Glyph(char p) => char.ToLower(p) switch
    {
        'k' => "\u265A",
        'q' => "\u265B",
        'r' => "\u265C",
        'b' => "\u265D",
        'n' => "\u265E",
        _ => "\u265F\uFE0E"
    };
}
