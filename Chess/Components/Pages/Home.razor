@page "/"

<PageTitle>ChessPlatform</PageTitle>

<section class="mx-auto max-w-3xl py-8 text-center sm:py-14">
    <span class="inline-flex items-center rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-300">
        Schach im Browser
    </span>

    <h1 class="mt-6 mb-0 text-4xl font-bold tracking-tight text-white sm:text-6xl">
        Spiele Schach mit allen <span class="text-emerald-400">offiziellen Regeln</span>
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-400">
        Zu zweit an einem Bildschirm oder gegen den Computer. Mit einem Konto werden deine Partien
        gespeichert, und du kannst sie Zug für Zug nachspielen.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="play" class="btn btn-lg btn-primary">Jetzt spielen</a>

        <AuthorizeView>
            <Authorized>
                <a href="games" class="btn btn-lg btn-secondary">Meine Partien</a>
            </Authorized>
            <NotAuthorized>
                <a href="Account/Register" class="btn btn-lg btn-secondary">Konto erstellen</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</section>

<section class="mx-auto mt-6 grid max-w-5xl gap-4 sm:grid-cols-3">
    <div class="panel">
        <h3 class="mb-2 text-base">Vollständige Regeln</h3>
        <p class="text-sm leading-relaxed text-slate-400">
            Rochade, en passant, Umwandlung, Schachmatt, Patt und Remis durch Wiederholung oder 50-Züge-Regel.
        </p>
    </div>
    <div class="panel">
        <h3 class="mb-2 text-base">Gegen den Computer</h3>
        <p class="text-sm leading-relaxed text-slate-400">
            Wähle deine Farbe und spiele gegen den Computer, oder zu zweit an einem Bildschirm.
        </p>
    </div>
    <div class="panel">
        <h3 class="mb-2 text-base">Deine Partien</h3>
        <p class="text-sm leading-relaxed text-slate-400">
            Mit einem Konto wird jede Partie gespeichert. Später spielst du sie Zug für Zug nach.
        </p>
    </div>
</section>
