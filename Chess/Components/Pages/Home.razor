@page "/"

<PageTitle>ChessPlatform</PageTitle>

<section class="mx-auto grid max-w-6xl items-center gap-12 py-10 lg:grid-cols-2 lg:py-16">
    <div>
        <h1 class="mb-0 text-5xl leading-[1.05] sm:text-6xl">Schach im Browser.</h1>

        <p class="mt-6 max-w-md text-lg leading-relaxed text-slate-400">
            Spiel zu zweit an einem Bildschirm oder gegen den Computer.
            Mit Konto wird jede Partie gespeichert und kann Zug für Zug nachgespielt werden.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
            <a href="play" class="btn btn-lg btn-primary">Neue Partie</a>

            <AuthorizeView>
                <Authorized>
                    <a href="games" class="btn btn-lg btn-secondary">Meine Partien</a>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Register" class="btn btn-lg btn-secondary">Konto anlegen</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    <figure class="mx-auto w-full max-w-md lg:max-w-none">
        <div class="grid aspect-square w-full grid-cols-8 overflow-hidden shadow-2xl shadow-black/50 ring-8 ring-slate-800">
            @for (var r = 0; r < 8; r++)
            {
                @for (var c = 0; c < 8; c++)
                {
                    var p = _b[r, c];
                    <div class="chess-square flex aspect-square items-center justify-center @((r + c) % 2 == 1 ? "bg-board-dark" : "bg-board-light")">
                        @if (p != '\0')
                        {
                            <span class="chess-piece select-none @(char.IsUpper(p) ? "text-white" : "text-slate-950")"
                                  style="@(char.IsUpper(p) ? "text-shadow:0 1px 2px rgb(0 0 0 / .55);" : "")">@Glyph(p)</span>
                        }
                    </div>
                }
            }
        </div>
        <figcaption class="mt-3 text-sm text-slate-500">Anderssen – Kieseritzky, London 1851. Weiß ist am Zug und hat gerade matt gesetzt.</figcaption>
    </figure>
</section>

@code {
    private readonly char[,] _b = Parse("r1bk3r/p2pBpNp/n4n2/1p1NP2P/6P1/3P4/P1P1K3/q5b1");

    private static char[,] Parse(string fen)
    {
        var b = new char[8, 8];
        var rows = fen.Split('/');
        for (var r = 0; r < 8; r++)
        {
            var c = 0;
            foreach (var ch in rows[r])
            {
                if (char.IsDigit(ch)) c += ch - '0';
                else b[r, c++] = ch;
            }
        }
        return b;
    }

    private static string Glyph(char p) => char.ToLower(p) switch
    {
        'k' => "\u265A",
        'q' => "\u265B",
        'r' => "\u265C",
        'b' => "\u265D",
        'n' => "\u265E",
        _ => "\u265F\uFE0E"
    };
}
