@page "/"

<PageTitle>ChessPlatform</PageTitle>

<section class="mx-auto grid max-w-6xl items-center gap-12 py-10 lg:grid-cols-[1.1fr_0.9fr] lg:py-20">
    <div>
        <p class="mb-4 text-sm uppercase tracking-[0.2em] text-slate-500">ChessPlatform</p>

        <h1 class="mb-0 text-5xl leading-[1.05] sm:text-6xl">
            Schach.<br />
            Jede Partie bleibt<br />
            erhalten.
        </h1>

        <p class="mt-6 max-w-md text-lg leading-relaxed text-slate-400">
            Spiel am selben Bildschirm oder gegen den Computer. Wer angemeldet ist,
            kann später jede Partie Zug für Zug durchgehen.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
            <a href="play" class="btn btn-lg btn-primary">Neue Partie</a>

            <AuthorizeView>
                <Authorized>
                    <a href="games" class="btn btn-lg btn-secondary">Meine Partien</a>
                </Authorized>
                <NotAuthorized>
                    <a href="Account/Register" class="btn btn-lg btn-secondary">Konto anlegen</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <dl class="mt-14 max-w-md divide-y divide-slate-800 border-y border-slate-800 text-sm">
            <div class="flex justify-between gap-6 py-3">
                <dt class="text-slate-500">Regeln</dt>
                <dd class="text-right text-slate-300">Rochade, en passant, Umwandlung, Patt, 50-Züge</dd>
            </div>
            <div class="flex justify-between gap-6 py-3">
                <dt class="text-slate-500">Gegner</dt>
                <dd class="text-right text-slate-300">Mensch oder Computer</dd>
            </div>
            <div class="flex justify-between gap-6 py-3">
                <dt class="text-slate-500">Speichern</dt>
                <dd class="text-right text-slate-300">Nach jedem Zug, mit Konto</dd>
            </div>
        </dl>
    </div>

    <figure class="mx-auto w-full max-w-md lg:max-w-none">
        <div class="grid aspect-square w-full grid-cols-8 overflow-hidden rounded-md shadow-2xl shadow-black/50 ring-8 ring-slate-800">
            @for (var r = 0; r < 8; r++)
            {
                @for (var c = 0; c < 8; c++)
                {
                    var piece = _board[r, c];
                    <div class="chess-square flex aspect-square items-center justify-center @((r + c) % 2 == 0 ? "bg-board-light" : "bg-board-dark")">
                        @if (piece != '\0')
                        {
                            <span class="chess-piece select-none @(char.IsUpper(piece) ? "text-white" : "text-slate-950")"
                                  style="text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);">@Glyph(piece)</span>
                        }
                    </div>
                }
            }
        </div>
        <figcaption class="mt-3 text-sm text-slate-500">
            Anderssen – Kieseritzky, London 1851. Weiß setzt mit zwei Springern und einem Läufer matt,
            obwohl Dame und beide Türme fehlen.
        </figcaption>
    </figure>
</section>

@code {
    private const string Fen = "r1bk3r/p2pBpNp/n4n2/1p1NP2P/6P1/3P4/P1P1K3/q5b1";

    private readonly char[,] _board = Parse(Fen);

    private static char[,] Parse(string fen)
    {
        var b = new char[8, 8];
        var rows = fen.Split('/');
        for (var r = 0; r < 8; r++)
        {
            var c = 0;
            foreach (var ch in rows[r])
            {
                if (char.IsDigit(ch)) c += ch - '0';
                else b[r, c++] = ch;
            }
        }
        return b;
    }

    private static string Glyph(char p) => char.ToLower(p) switch
    {
        'k' => "\u265A",
        'q' => "\u265B",
        'r' => "\u265C",
        'b' => "\u265D",
        'n' => "\u265E",
        _ => "\u265F\uFE0E"
    };
}
