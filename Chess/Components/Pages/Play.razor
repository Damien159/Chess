@page "/play"
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Chess.Components.Game
@using Chess.Data
@using Chess.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject GameRepository Repository
@inject ILogger<Play> Logger

<PageTitle>Spielen</PageTitle>

<div class="flex flex-col items-center gap-8 xl:flex-row xl:items-start xl:justify-center">

    @* Solange der Computer am Zug ist, sind Klicks auf das Brett gesperrt *@
    <div class="board-size shrink-0 @(IsComputerTurn ? "pointer-events-none" : "")">
        <ChessBoard @key="_game" Game="_game" Flipped="_flipped" OnMoved="HandleMoved" />
    </div>

    <aside class="flex w-full max-w-xl flex-col gap-4 xl:w-[400px]">

        <div class="panel p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Partie</p>
            <p class="@StatusClass mt-1 text-xl font-semibold">@StatusText</p>

            @if (_saveFailed)
            {
                <p class="mt-2 text-sm text-red-400">Die Partie konnte nicht gespeichert werden.</p>
            }
            else if (_userId is null)
            {
                <p class="mt-2 text-sm text-slate-500">
                    <a href="Account/Login" class="text-emerald-400 hover:underline">Melde dich an</a>,
                    damit deine Partien gespeichert werden.
                </p>
            }
            else if (_storedId is not null)
            {
                <p class="mt-2 text-sm text-slate-500">Partie wird gespeichert.</p>
            }
        </div>

        <div class="panel p-5">
            <p class="mb-3 text-xs font-medium uppercase tracking-wider text-slate-500">Spielmodus</p>
            <div class="flex flex-col gap-2">
                <button @onclick="() => SetModeAsync(null)" disabled="@_thinking" class="@ModeClass(null)">
                    <span class="font-medium">Zwei Spieler</span>
                    <span class="text-xs text-slate-400">Am selben Bildschirm</span>
                </button>
                <button @onclick="() => SetModeAsync(PieceColor.White)" disabled="@_thinking" class="@ModeClass(PieceColor.White)">
                    <span class="font-medium">Gegen Computer</span>
                    <span class="text-xs text-slate-400">Du spielst Weiß</span>
                </button>
                <button @onclick="() => SetModeAsync(PieceColor.Black)" disabled="@_thinking" class="@ModeClass(PieceColor.Black)">
                    <span class="font-medium">Gegen Computer</span>
                    <span class="text-xs text-slate-400">Du spielst Schwarz</span>
                </button>
            </div>
        </div>

        <CapturedPieces Label="Weiß hat geschlagen" Pieces="_game.GetCaptured(PieceColor.Black)" />
        <CapturedPieces Label="Schwarz hat geschlagen" Pieces="_game.GetCaptured(PieceColor.White)" />

        <MoveList Moves="_game.Moves" Result="_game.Result" />

        @if (!_game.IsOver && _game.DrawOfferedBy is { } offerer)
        {
            <div class="rounded-xl border border-yellow-500/40 bg-yellow-500/10 p-4 text-sm">
                <p class="mb-3 text-yellow-300">@ColorName(offerer) bietet Remis an.</p>
                <div class="flex gap-2">
                    <button @onclick="AcceptDraw" class="btn btn-primary">Annehmen</button>
                    <button @onclick="DeclineDraw" class="btn btn-secondary">Ablehnen</button>
                </div>
            </div>
        }

        <div class="flex flex-wrap gap-2">
            <button @onclick="StartNewGameAsync" disabled="@_thinking" class="btn btn-primary disabled:opacity-60">
                Neue Partie
            </button>
            <button @onclick="() => _flipped = !_flipped" class="btn btn-secondary">
                Brett drehen
            </button>
        </div>

        @if (!_game.IsOver && !_thinking)
        {
            <div class="flex flex-wrap items-center gap-2">
                @* Remis anbieten gibt es nur zwischen zwei Menschen *@
                @if (!VsComputer && _game.DrawOfferedBy is null)
                {
                    <button @onclick="OfferDraw" class="btn btn-secondary">Remis anbieten</button>
                }

                @if (_confirmResign)
                {
                    <span class="text-sm text-slate-300">@ColorName(ResignColor) wirklich aufgeben?</span>
                    <button @onclick="Resign" class="btn btn-danger">Ja</button>
                    <button @onclick="() => _confirmResign = false" class="btn btn-secondary">Abbrechen</button>
                }
                else
                {
                    <button @onclick="() => _confirmResign = true" class="btn btn-secondary text-red-300">
                        @ColorName(ResignColor) gibt auf
                    </button>
                }
            </div>
        }
    </aside>
</div>

@code {
    // Der gesamte Spielzustand lebt im Speicher dieses Objekts. Gespeichert wird erst nach einem Zug (SaveAsync).
    private Game _game = new();
    private bool _flipped;
    private bool _confirmResign;
    private string? _userId;

    // Datenbank-Id der Partie. Bleibt null bis zum ersten gespeicherten Zug.
    private int? _storedId;
    private bool _saveFailed;

    // Farbe des Menschen. null bedeutet: zwei Spieler am selben Bildschirm.
    private PieceColor? _humanColor;
    private bool _thinking;
    private readonly ComputerPlayer _computer = new();

    private bool VsComputer => _humanColor is not null;

    private bool IsComputerTurn =>
        _humanColor is { } human && !_game.IsOver && _game.CurrentTurn != human;

    // Gegen den Computer gibt immer der Mensch auf, bei zwei Spielern der Spieler am Zug
    private PieceColor ResignColor => _humanColor ?? _game.CurrentTurn;

    // Liest die Id des angemeldeten Benutzers. Ohne Anmeldung wird nichts gespeichert, gespielt werden kann trotzdem.
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    // Moduswechsel startet immer eine neue Partie. Spielt der Mensch Schwarz, wird das Brett
    // gedreht und der Computer macht den ersten Zug.
    private async Task SetModeAsync(PieceColor? humanColor)
    {
        _humanColor = humanColor;
        _flipped = humanColor == PieceColor.Black;
        await StartNewGameAsync();
    }

    private async Task StartNewGameAsync()
    {
        _game = new Game();
        _storedId = null;
        _saveFailed = false;
        _confirmResign = false;
        await PlayComputerMoveAsync();
    }

    // Wird vom Brett aufgerufen, nachdem der Mensch gezogen hat
    private async Task HandleMoved()
    {
        _confirmResign = false;
        await SaveAsync();
        await PlayComputerMoveAsync();
    }

    // Der Computer rechnet in einem Hintergrund-Task, damit die Oberfläche nicht einfriert.
    // Die kurze Pause sorgt dafür, dass man seinen Zug sieht, bevor der Computer antwortet.
    private async Task PlayComputerMoveAsync()
    {
        if (!IsComputerTurn)
        {
            return;
        }

        var game = _game;
        _thinking = true;
        StateHasChanged();

        try
        {
            await Task.Delay(400);
            var move = await Task.Run(() => _computer.ChooseMove(game));

            // Falls inzwischen eine neue Partie begonnen wurde, wird der alte Zug verworfen
            if (move is not null && ReferenceEquals(game, _game))
            {
                game.TryMove(move.From, move.To, move.Promotion);
                await SaveAsync();
            }
        }
        finally
        {
            _thinking = false;
        }
    }

    private void OfferDraw() => _game.OfferDraw(_game.CurrentTurn);

    private async Task AcceptDraw()
    {
        _game.AcceptDraw();
        await SaveAsync();
    }

    private void DeclineDraw() => _game.DeclineDraw();

    private async Task Resign()
    {
        _game.Resign(ResignColor);
        _confirmResign = false;
        await SaveAsync();
    }

    // Speichert nach jedem Zug. Ein Fehler beim Speichern darf das Spiel nicht abbrechen,
    // deshalb try/catch und ein Hinweis in der Oberfläche.
    private async Task SaveAsync()
    {
        if (_userId is null || _game.Moves.Count == 0)
        {
            return;
        }

        try
        {
            _storedId = await Repository.SaveAsync(_storedId, _userId, _game);
            _saveFailed = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving the game failed");
            _saveFailed = true;
        }
    }

    private string ModeClass(PieceColor? mode) =>
        "flex flex-col items-start rounded-xl border px-4 py-2.5 text-left text-sm transition disabled:opacity-60 " +
        (_humanColor == mode
            ? "border-emerald-500/60 bg-emerald-500/10 text-white"
            : "border-slate-800 bg-slate-900/60 text-slate-300 hover:border-slate-700 hover:bg-slate-800/60");

    private static string ColorName(PieceColor color) => color == PieceColor.White ? "Weiß" : "Schwarz";

    private string TurnName => ColorName(_game.CurrentTurn);

    private string StatusText => _thinking
        ? "Computer denkt nach …"
        : _game.Status switch
        {
            GameStatus.Check => $"Schach! {TurnName} ist am Zug",
            GameStatus.Checkmate => $"Schachmatt! {ColorName(_game.Winner!.Value)} gewinnt",
            GameStatus.Resigned => $"{ColorName(_game.Winner!.Value)} gewinnt durch Aufgabe",
            GameStatus.Stalemate => "Patt – Unentschieden",
            GameStatus.DrawByRepetition => "Remis durch dreifache Stellungswiederholung",
            GameStatus.DrawByFiftyMoveRule => "Remis durch die 50-Züge-Regel",
            GameStatus.DrawByInsufficientMaterial => "Remis – zu wenig Material für ein Matt",
            GameStatus.DrawByAgreement => "Remis durch Einigung",
            _ => $"Am Zug: {TurnName}"
        };

    private string StatusClass => _game.Status switch
    {
        GameStatus.Check => "text-red-400",
        GameStatus.Checkmate or GameStatus.Resigned => "text-emerald-400",
        GameStatus.Ongoing => "text-slate-200",
        _ => "text-yellow-400"
    };
}
